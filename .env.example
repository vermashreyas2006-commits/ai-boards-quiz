# ========================================================
# AI Boards Quiz - Environment Configuration Example
# ========================================================
# Copy this file to .env and insert your real Gemini API key:
#   copy .env.example .env
#
# Obtain a free or paid Gemini API Key from Google AI Studio:
#   https://aistudio.google.com/app/apikey
#
# Never commit your .env file or reveal your API key in version control!
# ========================================================

# Required: Google Gemini API Key
GEMINI_API_KEY=


# Optional: Server Port (defaults to 3000)
PORT=3000

# Optional: Preferred Gemini Model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
